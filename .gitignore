# ============================================================
#  NO ROM DUMPS OR GENERATED GAME CODE IN THIS REPOSITORY.
#  Wave Race 64 is Nintendo's; the user supplies their own ROM.
#  Separately credited replacement recordings live in assets/music.
#  Reviewed texture replacements live in assets/textures.
# ============================================================
*.z64
*.n64
*.v64
*.rom
baserom*
*.elf
*.o
*.a
*.bin
*.sym
*.map

# Recompiler output (regenerated from the user's ROM)
/RecompiledFuncs/
/RecompiledPatches/
recomp_overlays.inl
funcs.h
dump.toml
data_dump.toml

# splat / disassembly output
/asm/
/bin/
/expected/
/context/

# Build. Any build*/ directory: the runtime stack is configured into
# build-rt/ with a different compiler than the phase 00 tree in build/.
/build*/
/out/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
*.ninja
.ninja_deps
.ninja_log
compile_commands.json

# Tooling
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.user
Thumbs.db
desktop.ini

# Read-only upstream checkouts used as reference (never built, never shipped)
/reference/

# Release staging (tools/package_release.ps1)
/dist/

# Derived from the reference decomp's splat config at build time (tools/make_asm_only_yaml.py);
# that repository publishes no license, so the derivative is not committed.
/recomp/wr64.us.rev1.asm.yaml
